# WhatsApp Cloud API (System User token — shared across all university numbers)
WHATSAPP_ACCESS_TOKEN=
# Meta App Secret — used to verify X-Hub-Signature-256 on /webhook/whatsapp
META_APP_SECRET=
# Same string you enter in Meta Developer → WhatsApp → Configuration → Verify token
WEBHOOK_VERIFY_TOKEN=
# Optional Graph API version (default v21.0)
# WHATSAPP_GRAPH_API_VERSION=v21.0
